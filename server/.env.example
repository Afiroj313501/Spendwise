NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
# DIRECT_URL: if not using a separate connection pooler (e.g. Supabase pooler), set DIRECT_URL to the same value as DATABASE_URL
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
JWT_ACCESS_SECRET=replace_with_at_least_32_characters_long_secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_DAYS=7
# For separate frontend & backend domains (e.g. Vercel frontend + Render backend), set COOKIE_SAME_SITE=none
# For same domain or local development, use COOKIE_SAME_SITE=lax
COOKIE_SAME_SITE=lax
TRUST_PROXY_HOPS=1
